/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Las fotos se reemplazan a menudo conservando el mismo nombre de
# archivo (img/mi-cielo-oro-1.jpg y compañía). Antes cada foto se
# preguntaba al servidor en cada visita (max-age=0) y la web iba lenta.
# Ahora el navegador usa la que tiene guardada al momento y, por detrás,
# comprueba si ha cambiado (stale-while-revalidate): una foto nueva se ve
# como mucho en la visita siguiente, y si la de guardada tiene menos de
# 10 minutos ni siquiera pregunta.
/img/*
  Cache-Control: public, max-age=600, stale-while-revalidate=2592000
